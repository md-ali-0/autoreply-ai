<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/tvPermSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingBottom="3dp"
            android:text="@string/perm_summary"
            android:textColor="@color/brand_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            style="@style/RowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingBottom="13dp"
            android:text="@string/perm_intro" />

        <com.google.android.material.card.MaterialCardView style="@style/CardSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/rowNotif"
                    style="@style/PermRow">

                    <View
                        android:id="@+id/dotNotif"
                        style="@style/PermDot" />

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:text="@string/notif_access" />

                    <TextView
                        android:id="@+id/tvNotifState"
                        style="@style/PermState" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/rowAcc"
                    style="@style/PermRow">

                    <View
                        android:id="@+id/dotAcc"
                        style="@style/PermDot" />

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:text="@string/acc_service" />

                    <TextView
                        android:id="@+id/tvAccState"
                        style="@style/PermState" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/rowContacts"
                    style="@style/PermRow">

                    <View
                        android:id="@+id/dotContacts"
                        style="@style/PermDot" />

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:text="@string/contacts_perm" />

                    <TextView
                        android:id="@+id/tvContactsState"
                        style="@style/PermState" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/rowBattery"
                    style="@style/PermRow">

                    <View
                        android:id="@+id/dotBattery"
                        style="@style/PermDot" />

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:text="@string/battery_opt" />

                    <TextView
                        android:id="@+id/tvBatteryState"
                        style="@style/PermState" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout
                    android:id="@+id/rowOverlay"
                    style="@style/PermRow">

                    <View
                        android:id="@+id/dotOverlay"
                        style="@style/PermDot" />

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:text="@string/overlay_perm" />

                    <TextView
                        android:id="@+id/tvOverlayState"
                        style="@style/PermState" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/CardSurface"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/brand_container"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:text="@string/help_body"
                android:textColor="@color/brand_dark"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
